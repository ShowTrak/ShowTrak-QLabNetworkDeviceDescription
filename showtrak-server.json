{
  "identifier": "com.showtrak.server",
  "displayName": "ShowTrak Server",
  "grouping": "General",
  "api": 1,
  "messageType": "OSC",
  "network": [
    {
      "transport": "UDP",
      "defaultPort": 3333,
      "canEditPort": true
    }
  ],
  "parameters": [
    {
      "key": "message",
      "displayName": "Action",
      "type": "menu",
      "fadeable": false,
      "values": [
        { "Client: Wake on LAN": "clientWol" },
        { "Client: Run Script": "clientRunScript" },
        { "Client: Trigger Event": "clientTriggerEvent" },
        "---",
        { "Group: Wake on LAN": "groupWol" },
        { "Group: Run Script": "groupRunScript" },
        { "Group: Trigger Event": "groupTriggerEvent" },
        "---",
        { "Tag: Wake on LAN": "tagWol" },
        { "Tag: Run Script": "tagRunScript" },
        { "Tag: Trigger Event": "tagTriggerEvent" },
        "---",
        { "All Clients: Wake on LAN": "/All/WakeOnLAN" },
        { "All Clients: Run Script": "allRunScript" },
        { "All Clients: Trigger Event": "allTriggerEvent" },
        "---",
        { "Dummy: Send Heartbeat": "dummyHeartbeat" },
        "---",
        { "Server: Shutdown Gracefully": "/Shutdown" },
        { "Server: Shutdown Forcefully": "/Shutdown/Force" }
      ],
      "defaultValue": "/All/WakeOnLAN"
    },
    {
      "key": "prefix",
      "type": "string",
      "hidden": true,
      "pattern": ".*",
      "defaultValue": "/API"
    }
  ],
  "conditions": [
    {
      "predicate": "message in { '/Shutdown', '/Shutdown/Force', '/All/WakeOnLAN' }",
      "template": "{prefix}{message}"
    },
    {
      "predicate": "message == 'clientWol'",
      "template": "{prefix}/Client/{slug}/WakeOnLAN",
      "parameters": [
        {
          "key": "slug",
          "displayName": "Client Slug",
          "type": "string",
          "pattern": "^\\S+$"
        }
      ]
    },
    {
      "predicate": "message == 'clientRunScript'",
      "template": "{prefix}/Client/{slug}/RunScript/{scriptId}",
      "parameters": [
        {
          "key": "slug",
          "displayName": "Client Slug",
          "type": "string",
          "pattern": "^\\S+$"
        },
        {
          "key": "scriptId",
          "displayName": "Script ID",
          "type": "string",
          "pattern": "^\\S+$"
        }
      ]
    },
    {
      "predicate": "message == 'clientTriggerEvent'",
      "template": "{prefix}/Client/{slug}/TriggerEvent/{eventId}",
      "parameters": [
        {
          "key": "slug",
          "displayName": "Client Slug",
